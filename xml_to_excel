import pandas as pd
import xml.etree.ElementTree as ET
import os

# Функция для преобразования XML в DataFrame
def parse_xml_to_df(xml_file):
    tree = ET.parse(xml_file)
    root = tree.getroot()

    data = []
    for book in root.findall('.//КнПродСтр'):
        row = {}
        for elem in book:
            if elem.tag == 'СвПокуп':
                for sub_elem in elem:
                    row[sub_elem.tag] = sub_elem.attrib
            else:
                row[elem.tag] = elem.text
        data.append(row)

    return pd.DataFrame(data)

# Функция для записи DataFrame в Excel
def write_df_to_excel(df, base_filename, max_rows=500000):
    num_files = (len(df) // max_rows) + 1

    for i in range(num_files):
        start_idx = i * max_rows
        end_idx = start_idx + max_rows
        chunk = df[start_idx:end_idx]

        filename = f"{base_filename}_{i+1}.xlsx"
        chunk.to_excel(filename, index=False)
        print(f"Файл {filename} создан, записано {len(chunk)} строк.")

